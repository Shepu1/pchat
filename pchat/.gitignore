# SHEPU ROOMS — .gitignore

# ── Credentials & secrets ────────────────────────────────────────
# firebase-config.js contains your public API key (safe to commit),
# but service-account keys and .env secrets must never be committed.
.env
.env.*
secrets.*
service-account*.json

# ── Node / build ─────────────────────────────────────────────────
node_modules/
package-lock.json
dist/
build/
.cache/

# ── Firebase CLI ──────────────────────────────────────────────────
.firebase/
firestore-debug.log
ui-debug.log
database-debug.log

# ── Test / emulator artifacts ─────────────────────────────────────
# Keep tests/ source but ignore emulator data
.firestore/
emulator-data/

# ── Logs ──────────────────────────────────────────────────────────
*.log

# ── OS ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Editor ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Temp / scratch ────────────────────────────────────────────────
temp/
tmp/
*.tmp
*.bak
*.old
